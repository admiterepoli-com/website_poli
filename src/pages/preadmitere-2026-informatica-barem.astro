---
/**
 * Ported from legacy/preadmitere-2026-informatica-barem.html as its own page (#77): it shows an
 * answer table instead of a PDF, so it does not fit the PDF template. The
 * <main> markup, table included, is copied as it is.
 *
 * Unlike the matematica page, the legacy page has no inline <style>: the
 * table takes only the global 07-barem-cod.css rules.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Barem Preadmitere Politehnica 2026 – Informatică | AdmiterePoli"
  description="Baremul oficial pentru preadmiterea examenului de admitere la informatică, Universitatea Politehnica București (UPB) 2026. Verifică-ți răspunsurile!"
>
    <main>
        <section class="grid-main-content">
            <div class="container" style="margin-bottom: 2rem;">
                <div class="pag-intro">
                    <h1 style="text-align: left;">Barem Preadmitere Politehnica 2026 – Informatică</h1>

                    <h3 class="indented" style="margin-top: 1rem; font-weight: 500; line-height: 1.6; font-size: 1.5rem;">
                        Aici găsești baremul oficial de corectare pentru preadmiterea examenului de admitere la informatică, susținut la Universitatea Politehnica București (UPB) în 2026. Asigură-te că ai confruntat grilele cu răspunsurile de mai jos.
                    </h3>

                    <div style="margin-top: 1.5rem; background: rgba(225, 225, 225, 0.1); padding: 1.5rem; border-radius: 1rem;">
                        <h3 style="margin-bottom: 0.8rem; color: #C3D5F0; font-size: 1.3rem;">🔗 Linkuri utile:</h3>
                        <ul style="list-style-type: disc; margin-left: 1.5rem; font-size: 1.3rem;">
                            <li style="margin-bottom: 0.5rem;"><a href="./rezolvare-preadmitere-2026-informatica" style="color: lightblue;">Vezi rezolvarea scrisă la Informatică</a></li>
                            <li style="margin-bottom: 0.5rem;"><a href="./preadmitere-2026-info-subiect" style="color: lightblue;">Vezi subiectul la Informatică</a></li>
                            <li><a href="./preadmitere-2026-matematica-barem" style="color: lightblue;">Vezi baremul la Matematică</a></li>
                        </ul>
                    </div>
                </div>
            </div>

            <div class="barem-table-wrapper">
                <table class="barem-table">
                    <thead>
                        <tr>
                            <th>Număr Problemă</th>
                            <th>Info</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr><td>Problema 1</td><td>c</td></tr>
                        <tr><td>Problema 2</td><td>c</td></tr>
                        <tr><td>Problema 3</td><td>d</td></tr>
                        <tr><td>Problema 4</td><td>b</td></tr>
                        <tr><td>Problema 5</td><td>f</td></tr>
                        <tr><td>Problema 6</td><td>a</td></tr>
                        <tr><td>Problema 7</td><td>f</td></tr>
                        <tr><td>Problema 8</td><td>c</td></tr>
                        <tr><td>Problema 9</td><td>b</td></tr>
                        <tr><td>Problema 10</td><td>b</td></tr>
                    </tbody>
                </table>
            </div>

            <div class="container" style="margin-top: 2rem;">
                <h3 style="margin-bottom: 0.8rem; color: #C3D5F0; font-size: 1.3rem;">Subiecte similare care te-ar putea ajuta:</h3>
                <ul style="list-style-type: disc; margin-left: 1.5rem; font-size: 1.3rem;">
                    <li style="margin-bottom: 0.5rem;"><a href="./simulare-2026-informatica-barem" style="color: lightblue;">Barem Simulare 2026 Informatică</a></li>
                    <li style="margin-bottom: 0.5rem;"><a href="./preadmitere-2025-informatica-barem" style="color: lightblue;">Barem Preadmitere 2025 Informatică</a></li>
                </ul>
            </div>
        </section>
    </main>
</BaseLayout>
