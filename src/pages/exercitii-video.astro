---
/**
 * Ported from legacy/exercitii-video.html.
 *
 * Differences of the legacy page that BaseLayout props reproduce: no cookie
 * consent script (`cookieConsent={false}`), no WhatsApp popup, alt texts on
 * the footer icons, and its own font link (DM Sans + Plus Jakarta Sans, in the
 * head slot with `fonts="none"`).
 *
 * - The 700-line page <style> is kept unchanged in
 *   src/styles/pages/exercitii-video.css, imported after BaseLayout so Astro
 *   links it in <head> after the site CSS, as on the legacy page. (Inline at
 *   the top of the body it delayed the LCP, #89.)
 * - <main> and the video modal markup are copied as they are; the modal sat
 *   after the footer, so it is in the `scripts` slot (also after the footer).
 * - The inline module is now src/scripts/exercitii-video/ (catalog data in
 *   src/data/exercitii-video.ts).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/pages/exercitii-video.css';
---

<BaseLayout
  title="Exerciții Video · AdmiterePoli"
  description="Exerciții video pas cu pas pentru admiterea la Politehnica București — matematică și informatică."
  fonts="none"
  cookieConsent={false}
  popup={false}
  footerIconAlt
>
  <Fragment slot="head">
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  </Fragment>
        <main>
            <div class="grid-main-content">

                <!-- Hero -->
                <div class="ev-hero">
                    <div class="ev-hero-grain" aria-hidden="true"></div>
                    <div class="ev-hero-inner">
                        <div class="ev-hero-text">
                            <h1>Exerciții <em>video</em><br>pentru admitere</h1>
                            <p class="ev-hero-sub">Lecții de ~6 minute, filmate pas cu pas — matematică și informatică. Urmărește-le oriunde, oricând.</p>
                            <div class="ev-hero-stats" aria-label="Statistici catalog">
                                <div class="ev-stat">
                                    <span class="ev-stat-num">24</span>
                                    <span class="ev-stat-label">Lecții totale</span>
                                </div>
                                <div class="ev-stat">
                                    <span class="ev-stat-num">~6</span>
                                    <span class="ev-stat-label">Min / lecție</span>
                                </div>
                                <div class="ev-stat">
                                    <span class="ev-stat-num">2</span>
                                    <span class="ev-stat-label">Discipline</span>
                                </div>
                            </div>
                        </div>
                        <div class="ev-hero-panel">
                            <div class="ev-access-card is-free">
                                <div class="ev-access-icon" aria-hidden="true">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                                </div>
                                <div class="ev-access-info">
                                    <p class="ev-access-tier">Cont Gratuit</p>
                                    <p class="ev-access-desc">3 lecții / disciplină</p>
                                </div>
                            </div>
                            <div class="ev-access-card is-plus">
                                <div class="ev-access-icon" aria-hidden="true">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                                </div>
                                <div class="ev-access-info">
                                    <p class="ev-access-tier">Student Plus</p>
                                    <p class="ev-access-desc">Tot catalogul deblocat</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Catalog -->
                <div class="ev-catalog">
                    <div class="ev-tabs-row">
                        <div class="ev-tabs" role="tablist" aria-label="Disciplină">
                            <button type="button" class="ev-tab active" data-tab="mate"
                                    role="tab" aria-selected="true" id="ev-tab-mate" aria-controls="tab-mate">
                                Matematică
                            </button>
                            <button type="button" class="ev-tab" data-tab="info"
                                    role="tab" aria-selected="false" id="ev-tab-info" aria-controls="tab-info">
                                Informatică
                            </button>
                        </div>
                        <span class="ev-tabs-label" aria-hidden="true">12 lecții / disciplină</span>
                    </div>

                    <div class="ev-section active" id="tab-mate" role="tabpanel" aria-labelledby="ev-tab-mate"></div>
                    <div class="ev-section"        id="tab-info" role="tabpanel" aria-labelledby="ev-tab-info"></div>
                </div>

            </div>
        </main>
  <Fragment slot="scripts">
        <!-- Video Modal -->
        <div class="ev-modal-overlay" id="ev-modal-overlay" role="dialog" aria-modal="true" aria-labelledby="ev-modal-title">
            <div class="ev-modal">
                <div class="ev-modal-header">
                    <div>
                        <p class="ev-modal-num" id="ev-modal-num"></p>
                        <h2 class="ev-modal-title" id="ev-modal-title"></h2>
                    </div>
                    <button class="ev-modal-close" id="ev-modal-close" aria-label="Închide">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                    </button>
                </div>
                <div class="ev-modal-video-wrap" id="ev-modal-video"></div>
                <div class="ev-modal-body">
                    <p class="ev-modal-section-label">Cerința problemei</p>
                    <p class="ev-modal-statement" id="ev-modal-statement"></p>
                </div>
            </div>
        </div>

    <script>
      import { initExercitiiVideo } from '../scripts/exercitii-video/init';

      initExercitiiVideo();
    </script>
  </Fragment>
</BaseLayout>
