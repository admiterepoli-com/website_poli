---
/**
 * REFERENCE EXAMPLE of a ported page. Copy this pattern for other pages.
 *
 * How this page was ported from legacy/cti-vs-is.html:
 * 1. <head>: only title and description are passed to BaseLayout. Cookie
 *    consent, analytics, fonts, favicon and the stylesheet come from the layout.
 * 2. <header>, <footer>, the WhatsApp popup and the auth script are NOT copied:
 *    the layout renders them. Use the layout props when the legacy page
 *    differs from the default (see BaseLayout.astro for the list).
 * 3. Everything between <main> and </main> is copied as it is: same tags,
 *    classes, inline styles, texts and links. Do not tidy it up.
 *    Blocks that repeat across content pages (section cards, pill tags,
 *    grids, comparison table, CTA box) use the components in
 *    src/components/content/. They render the same tags and classes; texts,
 *    links and inline styles are passed as props, unchanged.
 * 4. legacy/cti-vs-is.html is deleted in the same PR.
 *
 * Before opening the PR:
 *   npm run build && npm run seo:check && npm run visual -- cti-vs-is
 *
 * Notes for this page: its <noscript> popup text is the heading-only version,
 * hence popupNoscript="title".
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import AccentCard from '../components/content/AccentCard.astro';
import CardGrid from '../components/content/CardGrid.astro';
import ComparisonTable from '../components/content/ComparisonTable.astro';
import CtaBox from '../components/content/CtaBox.astro';
import MateriiBox from '../components/content/MateriiBox.astro';
import SectionCard from '../components/content/SectionCard.astro';
import type { ComparisonColumn, ComparisonRow } from '../components/content/types';

const columns: ComparisonColumn[] = [
  { tag: { variant: 'cti', label: 'CTI' }, label: 'Calculatoare' },
  { tag: { variant: 'is', label: 'IS' }, label: 'Ingineria Sistemelor' },
];

const rows: ComparisonRow[] = [
  {
    label: 'Focus Principal',
    cells: [
      'Software, Algoritmi, Arhitectura calculatoarelor',
      'Hardware, Automatizări, Robotică, Controlul sistemelor',
    ],
  },
  {
    label: 'Materiile studiate',
    cells: [
      'Mai multă Programare, Baze de Date, Rețele',
      'Mai multă Fizică, Electronică, Matematică aplicată',
    ],
  },
  {
    label: 'Concurența la Admitere',
    cells: ['Medii de intrare de obicei mai mari', 'Medii de intrare ușor mai mici'],
  },
  {
    label: 'Joburi tipice',
    cells: [
      'Software Developer, DevOps, Data Engineer, Cybersecurity',
      'Automation Engineer, System Integrator, Embedded Developer',
    ],
  },
];
---

<BaseLayout
  title="CTI vs IS – Comparație Detaliată | AdmiterePoli"
  description="Ești nehotărât între Calculatoare (CTI) și Ingineria Sistemelor (IS)? Află diferențele reale, materiile studiate și joburile după absolvire la ACS UPB."
  popupNoscript="title"
>
  <main>
      <section class="grid-main-content">

          <!-- HERO -->
          <div class="hero-comparatie">
              <a href="./informatii" class="hero-back-btn">← Înapoi la Informații</a>
              <span class="badge">Ghid complet ACS</span>
              <h1>CTI vs IS</h1>
              <p>Alegerea specializării la Facultatea de Automatică și Calculatoare (ACS) este una dintre cele mai importante decizii. Ambele sunt de top, dar te pregătesc pentru cariere ușor diferite. Iată ce trebuie să știi.</p>
          </div>

          <!-- TABEL COMPARATIV -->
          <SectionCard title="Tabel Comparativ Rapid" delay="0.1s">
              <ComparisonTable criterion="Criteriu" columns={columns} rows={rows} />
          </SectionCard>

          <!-- CE VREI SA STUDIEZI -->
          <SectionCard title="Ce vei studia efectiv?" delay="0.15s">
              <CardGrid kind="materii">
                  <MateriiBox title="Materiile de la CTI" titleStyle="color:var(--accent2)">
                      <p>Vei aprofunda modul în care funcționează software-ul și cum comunică cu componentele fizice ale unui calculator.</p>
                      <ul>
                          <li>Programare (C, C++, Java, Python)</li>
                          <li>Structuri de date și Algoritmi</li>
                          <li>Sisteme de Operare și Baze de Date</li>
                          <li>Proiectarea Microprocesoarelor</li>
                          <li>Inteligență Artificială și Machine Learning</li>
                      </ul>
                  </MateriiBox>
                  <MateriiBox title="Materiile de la IS" titleStyle="color:var(--accent3)">
                      <p>Focusul pică pe interacțiunea dintre programe și lumea fizică (procese industriale, roboți, semafoare inteligente).</p>
                      <ul>
                          <li>Teoria Sistemelor (matematică avansată aplicată)</li>
                          <li>Electronică analogică și digitală</li>
                          <li>Semnale și Sisteme</li>
                          <li>Robotică și control industrial</li>
                          <li>Programarea micro-controlerelor (C/C++)</li>
                      </ul>
                  </MateriiBox>
              </CardGrid>
          </SectionCard>

          <!-- MITURI SI REALITATE -->
          <SectionCard title="Mituri și Realitate" delay="0.2s">
              <CardGrid kind="myth">
                  <AccentCard variant="myth" title='Mit: „Dacă termin IS, nu pot să mă angajez ca programator web/software."'>
                      <p><strong style="color:var(--accent3)">Realitate:</strong> Nu este imposibil, dar nici garantat. La IS, facultatea te pregătește în principal pentru hardware, automatizări și programare low-level (C/C++). Dacă vrei să te angajezi ca Web Developer sau Software Engineer pe tehnologii moderne (Java, Python, Web), va trebui să înveți destul de mult singur. E un mic „trap": vei avea multă matematică și fizică pentru facultate, în timp ce va trebui să îți găsești timp și pentru proiecte personale de programare.</p>
                  </AccentCard>
                  <AccentCard variant="myth" title='Mit: „La CTI e doar programare și zero fizică."'>
                      <p><strong style="color:var(--accent3)">Realitate:</strong> Fiind o facultate de inginerie (UPB), vei face fizică și electronică și la CTI (mai ales în primii doi ani), dar ponderea acestor materii este mult mai mică în comparație cu IS.</p>
                  </AccentCard>
              </CardGrid>
          </SectionCard>

          <!-- VERDICT / PENTRU CINE -->
          <SectionCard title="Pentru cine este fiecare secție?" delay="0.25s">
              <CardGrid kind="triple">
                  <AccentCard variant="cti" title="Alege CTI dacă…">
                      <ul>
                          <li>Ți-a plăcut foarte mult informatica în liceu și vrei să scrii cod</li>
                          <li>Te pasionează crearea de aplicații complexe, AI și rețelele de calculatoare</li>
                          <li>Vrei să înțelegi cum funcționează un calculator „sub capotă" la nivel de software</li>
                          <li>Ești atras de startup-uri tech sau roluri de Software Engineer</li>
                      </ul>
                  </AccentCard>
                  <AccentCard variant="is" title="Alege IS dacă…">
                      <ul>
                          <li>Ești pasionat de cum interacționează tehnologia cu lumea reală (hardware, senzori, roboți)</li>
                          <li>Te atrag drone, mașini autonome și sisteme de automatizare</li>
                          <li>Îți place fizica și ești dispus să înveți multă matematică aplicată</li>
                          <li>Vrei să automatizezi sisteme complexe din industrie</li>
                      </ul>
                  </AccentCard>
              </CardGrid>
          </SectionCard>

          <!-- PROGRAME OFICIALE -->
          <SectionCard title="Programe oficiale & resurse" delay="0.3s">
              <div class="sfat-info" style="margin:0 0 1rem 0">
                  <p>Consultă programa detaliată : <em>Programa Oficială UPB ACS –</em>
                      <span class="links">
                          <a href="https://acs.pub.ro/public/2025_29_PLi_L_03_FAC_CTI_Calculatoare_f.pdf" target="_blank">CTI</a>
                          <span class="separator">|</span>
                          <a href="https://acs.pub.ro/public/2025_29_PLi_L_03_FAC_AIASI_Automatica-si-informatica-aplicata_f.pdf" target="_blank">AIASI</a>
                      </span>
                  </p>
              </div>
              <CtaBox
                  text="Vrei să explorezi și alte informații despre admitere?"
                  href="./informatii"
                  label="Vezi toate informațiile"
              />
          </SectionCard>

      </section>
  </main>
</BaseLayout>
