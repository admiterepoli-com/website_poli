---
/**
 * Ported from legacy/contact.html (see src/pages/cti-vs-is.astro for the
 * general pattern).
 *
 * Notes for this page:
 * - Plus Jakarta Sans fonts and the default body class "lp-body lp-dark".
 * - The <noscript> popup text is the `weekly` version (the default).
 * - The <main> markup is copied as it is.
 * - The form is wired by the typed initContactForm() from
 *   src/scripts/contact-form.ts; main.js is not loaded. SweetAlert2 comes
 *   from npm (it injects its own CSS), so the legacy CDN
 *   `sweetalert2@11` script tag is dropped. Validation is left to the
 *   browser, as in legacy.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contactează-ne"
  description="Ia legătura cu echipa admiterepoli pentru orice întrebări, sugestii sau detalii despre admiterea la facultate!"
>
        <main>
            <div class="ad-left"></div>
            <section class="grid-main-content contact-page">
                <div class="contact-card">

                    <!-- Panoul stâng — identitate + social -->
                    <div class="contact-panel-left">
                        <div class="contact-panel-deco" aria-hidden="true"></div>
                        <h1 class="contact-panel-title">Hai să<br>vorbim.</h1>
                        <p class="contact-panel-sub">Orice întrebare, sugestie sau feedback — suntem aici pentru tine.</p>
                        <a href="mailto:admiterepoli@gmail.com" class="contact-info-pill">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                            admiterepoli@gmail.com
                        </a>
                        <div class="contact-socials">
                            <a href="https://chat.whatsapp.com/Fc7xjNckFGYBE9E16xsZ1D" target="_blank" rel="noopener noreferrer" class="contact-social-btn contact-social-wa">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.127.558 4.126 1.533 5.86L.057 23.944l6.244-1.637A11.944 11.944 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.815 9.815 0 0 1-5.006-1.368l-.358-.214-3.714.975.99-3.62-.234-.372A9.818 9.818 0 0 1 2.182 12C2.182 6.57 6.57 2.182 12 2.182S21.818 6.57 21.818 12 17.43 21.818 12 21.818z"/></svg>
                                WhatsApp
                            </a>
                            <a href="https://www.instagram.com/admitere.poli?igsh=MTMzNjNjMHoyZDIyZQ%3D%3D&utm_source=qr" target="_blank" rel="noopener noreferrer" class="contact-social-btn contact-social-ig">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
                                Instagram
                            </a>
                        </div>
                    </div>

                    <!-- Panoul drept — formularul -->
                    <div class="contact-panel-right">
                        <form id="contact-form">
                            <h2>Trimite-ne un mesaj</h2>
                            <div class="input-box" data-dot="blue">
                                <label for="fullname">Nume complet</label>
                                <input type="text" id="fullname" name="fullname" class="field" placeholder="Introdu numele tău complet" required />
                            </div>
                            <div class="input-box" data-dot="teal">
                                <label for="email">Adresa de email</label>
                                <input type="email" id="email" name="email" class="field" placeholder="Introdu adresa ta de email" required />
                            </div>
                            <div class="input-box" data-dot="indigo">
                                <label for="message">Mesajul tău</label>
                                <textarea id="message" name="message" class="field mess" placeholder="Scrie mesajul tău" required></textarea>
                            </div>
                            <button type="submit">Trimite mesajul</button>
                        </form>
                    </div>

                </div>
            </section>
            <div class="ad-right"></div>
        </main>
  <Fragment slot="scripts">
    <script>
      import { initContactForm } from '../scripts/contact-form';

      initContactForm();
    </script>
  </Fragment>
</BaseLayout>
