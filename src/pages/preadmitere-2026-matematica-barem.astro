---
/**
 * Ported from legacy/preadmitere-2026-matematica-barem.html as its own page (#77): it shows an
 * answer table instead of a PDF, so it does not fit the PDF template. The
 * <main> markup, table included, is copied as it is.
 *
 * The legacy inline <style> block is kept unchanged at the top of the body
 * (not in the head slot) so that it still comes after the bundled site CSS
 * and overrides the `.barem-table` rules of 07-barem-cod.css as on the
 * legacy page (see PORTING.md).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Barem Preadmitere Politehnica 2026 – Matematică | AdmiterePoli"
  description="Baremul oficial pentru preadmiterea examenului de admitere la matematică, Universitatea Politehnica București (UPB) 2026. Verifică-ți răspunsurile!"
>
    <style is:inline>
        .barem-table-wrapper {
            overflow-x: auto;
            margin: 2rem auto;
            max-width: 600px;
            background: var(--glass-bg);
            border: 1px solid var(--glass-border);
            border-radius: 16px;
            box-shadow: 0 8px 32px rgba(0,0,0,0.3), inset 0 1px 0 var(--glass-shine);
            backdrop-filter: blur(16px) saturate(1.5);
            -webkit-backdrop-filter: blur(16px) saturate(1.5);
        }

        .barem-table {
            width: 100%;
            border-collapse: collapse;
            text-align: center;
            color: var(--text-heading);
            font-family: 'DM Sans', sans-serif;
        }

        .barem-table th, .barem-table td {
            padding: 15px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        }

        .barem-table th {
            background: rgba(123, 160, 217, 0.1);
            font-weight: 700;
            font-size: 1.1rem;
            letter-spacing: 0.5px;
        }

        .barem-table th:nth-child(2) { color: var(--accent2); }

        .barem-table tr:last-child td {
            border-bottom: none;
        }

        .barem-table tr:hover td {
            background: rgba(123, 160, 217, 0.05);
        }

        .barem-table td {
            font-size: 1.05rem;
            font-weight: 500;
        }

        .barem-table td:first-child {
            text-align: left;
            padding-left: 25px;
            color: var(--muted);
        }
    </style>
    <main>
        <section class="grid-main-content">
            <div class="container" style="margin-bottom: 2rem;">
                <div class="pag-intro">
                    <h1 style="text-align: left;">Barem Preadmitere Politehnica 2026 – Matematică</h1>

                    <h3 class="indented" style="margin-top: 1rem; font-weight: 500; line-height: 1.6; font-size: 1.5rem;">
                        Aici găsești baremul oficial de corectare pentru preadmiterea examenului de admitere la matematică, susținut la Universitatea Politehnica București (UPB) în 2026. Asigură-te că ai confruntat grilele cu răspunsurile de mai jos.
                    </h3>

                    <div style="margin-top: 1.5rem; background: rgba(225, 225, 225, 0.1); padding: 1.5rem; border-radius: 1rem;">
                        <h3 style="margin-bottom: 0.8rem; color: #C3D5F0; font-size: 1.3rem;">🔗 Linkuri utile:</h3>
                        <ul style="list-style-type: disc; margin-left: 1.5rem; font-size: 1.3rem;">
                            <li style="margin-bottom: 0.5rem;"><a href="./preadmitere-2026-mate-subiect" style="color: lightblue;">Vezi subiectul la Matematică</a></li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Tabel Grilă Răspunsuri -->
            <div class="barem-table-wrapper">
                <table class="barem-table">
                    <thead>
                        <tr>
                            <th>Număr Problemă</th>
                            <th>Mate</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr><td>Problema 1</td><td>e</td></tr>
                        <tr><td>Problema 2</td><td>b</td></tr>
                        <tr><td>Problema 3</td><td>a</td></tr>
                        <tr><td>Problema 4</td><td>f</td></tr>
                        <tr><td>Problema 5</td><td>a</td></tr>
                        <tr><td>Problema 6</td><td>b</td></tr>
                        <tr><td>Problema 7</td><td>f</td></tr>
                        <tr><td>Problema 8</td><td>f</td></tr>
                        <tr><td>Problema 9</td><td>c</td></tr>
                        <tr><td>Problema 10</td><td>c</td></tr>
                    </tbody>
                </table>
            </div>

            <div class="container" style="margin-top: 2rem;">
                <h3 style="margin-bottom: 0.8rem; color: #C3D5F0; font-size: 1.3rem;">Subiecte similare care te-ar putea ajuta:</h3>
                <ul style="list-style-type: disc; margin-left: 1.5rem; font-size: 1.3rem;">
                    <li style="margin-bottom: 0.5rem;"><a href="./simulare-2026-matematica-barem" style="color: lightblue;">Barem Simulare 2026 Matematică</a></li>
                    <li style="margin-bottom: 0.5rem;"><a href="./preadmitere-2025-matematica-barem" style="color: lightblue;">Barem Preadmitere 2025 Matematică</a></li>
                </ul>
            </div>
        </section>
    </main>
</BaseLayout>
