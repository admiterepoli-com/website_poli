---
/**
 * Ported from legacy/simulari.html.
 *
 * - The four archive entries are <Dropdown>s (plain bold label, `headerId`
 *   on simulations 3 and 4, the legacy inline style on `.sub-links`); their
 *   sections are copied as they are.
 * - The scripts legacy main.js ran here are loaded once through the
 *   `scripts` slot, before the auth module as on the legacy page: dropdown
 *   toggle, the countdown button (`#glass-countdown-btn`, target from its
 *   `data-target`) and the scheduled reveal.
 * - The paid / locked / sale-closed states of the archive entries are set by
 *   `applySimulariPaidLinks` (src/lib/firebase/simulari-lock.ts), which the
 *   auth module from BaseLayout runs, using the header and dropdown ids.
 *
 * No inline <style> and no other page script on the legacy page.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Dropdown from '../components/Dropdown.astro';
---

<BaseLayout
  popupNoscript="info"
  title="Simulări AdmiterePoli | Testează-te pentru Preadmitere"
  description="Simulări gratuite pentru admiterea la Universitatea Politehnica București. Testează-ți cunoștințele la matematică și informatică în condiții reale de examen."
>
    <main>
        <div class="grid-main-content">
            <section class="container" style="padding-bottom: 1rem; overflow: visible;">

                <div class="sim-start">
                    <h1>Simulări AdmiterePoli</h1>
                    <p class="sim-start-subtitle">
                        Cea mai bună pregătire pentru examen este testarea în condiții reale.
                        Simulările noastre reproduc fidel examenul oficial de preadmitere.
                    </p>

                    <div class="sim-rules">
                        <h3>Regulament</h3>
                        <div class="sim-rules-list">
                            <div class="sim-rule">
                                <div class="sim-rule-icon r-time">&#9201;</div>
                                <div>Durata simulării este <b>3 ore</b>, aceeași ca la examenul oficial de preadmitere.</div>
                            </div>
                            <div class="sim-rule">
                                <div class="sim-rule-icon r-info">10</div>
                                <div>Fiecare secțiune conține 10 întrebări grilă cu răspuns unic.</div>
                            </div>
                            <div class="sim-rule">
                                <div class="sim-rule-icon r-switch">&#8644;</div>
                                <div>Începând cu simularea <b>#3</b>, aveți opțiunea de a alege între <b>Fizică</b> și <b>Informatică</b>.</div>
                            </div>
                            <div class="sim-rule">
                                <div class="sim-rule-icon r-switch">&#10006;</div>
                                <div>Folosirea oricărui model <b>AI este descurajată</b>. La examen nu ai AI — îți pierzi doar timpul.</div>
                            </div>
                            <div class="sim-rule">
                                <div class="sim-rule-icon r-submit">&#128241;</div>
                                <div>Urmărește <b>canalul de WhatsApp</b> pentru anunțuri.
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="sim-countdown-wrap">
                        <span class="sim-countdown-label">Următoarea simulare</span>
                        <a href="./simulare-2026-07-21" id="glass-countdown-btn" class="liquid-glass-btn locked"
                           data-target="2026-07-21T17:00:00+03:00">
                            <span class="countdown-text" id="countdown-timer">Se calculează...</span>
                            <span class="ready-text" style="color: rgb(221, 221, 221);">Intră în Simulare &rarr;</span>
                        </a>
                        <span class="sim-countdown-hint">Butonul se deblochează automat la data simulării</span>
                    </div>

                <div class="sim-archive">
                    <div class="sim-archive-header">
                        <h3>Simulări anterioare</h3>
                        <span class="sim-archive-badge">ARHIVĂ</span>
                    </div>

                    <div class="set-container">
                        <!-- Intrarea de arhivă pentru Simularea #4 e vizibilă permanent, cu lăcăt.
                             applySimulariLock decide ce se vede înăuntru: 🕐 până pe 21 iulie la
                             17:00 (închis pentru toţi, inclusiv plătitori), apoi 🔒 doar pentru
                             neplătitori. Pe 24 iulie la 10:00 baremul devine public.
                             Fără firebase-auth.js linkurile rămân la vedere — de aceea subiectul
                             şi baremul au gate propriu pe pagina lor. -->
                        <Dropdown set="arhiva-sim-4" headerId="sim4-header" label="Simulare #4 — 21–24 Iulie 2026"
                            bodyStyle="display: flex; justify-content: center; margin: 0; padding: 0;">
                                <section style="display: flex; flex-direction: column; align-items: center;">
                                    <h3 style="color: #ffffff; margin-bottom: 0.8rem; text-align: center;">Simulare 4 2026 — Informatică</h3>

                                    <div style="display: grid; grid-template-columns: auto auto; gap: 0.5rem 0.5rem; text-align: left;">
                                        <p style="margin: 0;"><em>Subiect:</em></p>
                                        <span class="links" style="margin: 0;"><a href="./simulare-2026-07-21" target="_blank">Apasă aici</a></span>

                                        <p style="margin: 0;"><em>Barem:</em></p>
                                        <span class="links" style="margin: 0;"><a href="./barem-simulare-admiterepoli-4" target="_blank">Apasă aici</a></span>

                                        <p style="margin: 0;"><em>Rezolvare:</em></p>
                                        <span class="links" style="margin: 0;"><a href="./rezolvare-simulare-admiterepoli-4" target="_blank">Apasă aici</a></span>
                                    </div>
                                </section>
                        </Dropdown>
                        <Dropdown set="arhiva-sim-3" headerId="sim3-header" label="Simulare #3 — 9 Mai 2026"
                            bodyStyle="display: flex; justify-content: center; margin: 0; padding: 0;">
                                <section style="display: flex; flex-direction: column; align-items: center;">
                                    <h3 style="color: #ffffff; margin-bottom: 0.8rem; text-align: center;">Simulare 3 2026</h3>

                                    <div style="display: grid; grid-template-columns: auto auto; gap: 0.5rem 0.5rem; text-align: left;">
                                        <p style="margin: 0;"><em>Subiect:</em></p>
                                        <span class="links" style="margin: 0;"><a href="./simulare-2026-05-09" target="_blank">Apasă aici</a></span>

                                        <p style="margin: 0;"><em>Barem:</em></p>
                                        <span class="links" style="margin: 0;"><a href="./barem-simulare-admiterepoli-3" target="_blank">Apasă aici</a></span>

                                        <p style="margin: 0;"><em>Rezolvare:</em></p>
                                        <span class="links" style="margin: 0;"><a href="./rezolvare-simulare-admiterepoli-3" target="_blank">Apasă aici</a></span>
                                    </div>
                                </section>
                        </Dropdown>
                        <Dropdown set="arhiva-sim-2" label="Simulare #2 — 26 Martie 2026"
                            bodyStyle="display: flex; justify-content: center; margin: 0; padding: 0;">
                                <section style="display: flex; flex-direction: column; align-items: center;">
                                    <h3 style="color: #ffffff; margin-bottom: 0.8rem; text-align: center;">Simulare 2 2026</h3>

                                    <div style="display: grid; grid-template-columns: auto auto; gap: 0.5rem 0.5rem; text-align: left;">
                                        <p style="margin: 0;"><em>Subiect:</em></p>
                                        <span class="links" style="margin: 0;"><a href="./simulare-2026-03-26" target="_blank">Apasă aici</a></span>

                                        <p style="margin: 0;"><em>Barem:</em></p>
                                        <span class="links" style="margin: 0;"><a href="./barem-simulare-admiterepoli-2" target="_blank">Apasă aici</a></span>

                                        <p style="margin: 0;"><em>Rezolvare:</em></p>
                                        <span class="links" style="margin: 0;"><a href="./rezolvare-simulare-admiterepoli-2" target="_blank">Apasă aici</a></span>
                                    </div>
                                </section>
                        </Dropdown>
                        <Dropdown set="arhiva-sim-1" label="Simulare #1 — 21 Martie 2026"
                            bodyStyle="display: flex; justify-content: center; margin: 0; padding: 0;">
                                <section style="display: flex; flex-direction: column; align-items: center;">
                                    <h3 style="color: #ffffff; margin-bottom: 0.8rem; text-align: center;">Simulare  1 2026</h3>

                                    <div style="display: grid; grid-template-columns: auto auto; gap: 0.5rem 0.5rem; text-align: left;">
                                        <p style="margin: 0;"><em>Subiect:</em></p>
                                        <span class="links" style="margin: 0;"><a href="./simulare-2026-03-21" target="_blank">Apasă aici</a></span>

                                        <p style="margin: 0;"><em>Barem:</em></p>
                                        <span class="links" style="margin: 0;"><a href="./barem-simulare-admiterepoli-1" target="_blank">Apasă aici</a></span>

                                        <p style="margin: 0;"><em>Rezolvare:</em></p>
                                        <span class="links" style="margin: 0;"><a href="./rezolvare-simulare-admiterepoli-1" target="_blank">Apasă aici</a></span>
                                    </div>
                                </section>
                        </Dropdown>
                    </div>
                </div>
                </div>
            </section>
        </div>
    </main>
  <Fragment slot="scripts">
    <script>
      import { initDropdowns } from '../scripts/dropdown';
      import { initCountdown } from '../scripts/countdown';
      import { initScheduledReveal } from '../scripts/reveal';

      initScheduledReveal();
      initCountdown();
      initDropdowns();
    </script>
  </Fragment>
</BaseLayout>
