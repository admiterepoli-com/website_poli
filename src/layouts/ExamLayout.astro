---
/**
 * Layout of the timed simulation pages (`simulare-2026-*`): the page skeleton
 * the exam engine fills in. Usage:
 *
 *   ---
 *   import ExamLayout from '../layouts/ExamLayout.astro';
 *   import exam from '../data/simulations/<file>';
 *   ---
 *   <ExamLayout title="..." description="..." config={exam}>
 *     <Fragment slot="track-selector">
 *       ...badge, h1, subtitle and track cards copied from the legacy #track-selector...
 *     </Fragment>
 *     <Fragment slot="scripts">
 *       <script>
 *         import exam from '../data/simulations/<file>';
 *         import { mountExam } from '../lib/exam/results';
 *         mountExam(exam, { saveTrack: false }); // `true` only on simulation 4
 *       </script>
 *     </Fragment>
 *   </ExamLayout>
 *
 * What it renders:
 * - head: for paid simulations, the classic inline script that sets
 *   `window.simulationId` and, when the config has them, the label, buy URL
 *   and gate start (`examGateStart`, `examGateStartLabel`), so the gate reads
 *   them before any module runs; then KaTeX; then, on pages with track
 *   selection, the page stylesheet that the legacy pages carried in an inline
 *   `<style>` (track cards, `fizica-mode` recolouring, circuit figures);
 * - body: `#exam-gate` and `#exam-content` with the `GateFallback` safety net
 *   (paid simulations only: on a free page nothing would ever show the
 *   content), `#track-selector` around the `track-selector` slot, the sticky
 *   timer, the tabs and panels, the submit summary and `#results-screen`.
 *
 * The skeleton text is part of the SEO baseline even while hidden, and it
 * comes in three legacy generations:
 * - no track selection (simulations 1 and 2): no gate, no `disc-*` ids, the
 *   problem counts written into the markup (`0/20`, `0 / 10 rezolvate`, `/10`);
 * - track selection with `staticCounts` (simulation 3): gate and `disc-*` ids,
 *   still the written counts, no `submit-total-*` spans;
 * - track selection (simulation 4): zeros everywhere (`0/0`) and
 *   `submit-total-*` spans that the engine fills.
 * The counts come from the first track; every legacy track of a simulation has
 * the same number of problems.
 *
 * Header, footer and body class are those of `BaseLayout` (modern header,
 * `lp-body lp-dark`, Plus Jakarta Sans); the simulations have no popup.
 */
import BaseLayout from './BaseLayout.astro';
import GateFallback from '../components/GateFallback.astro';
import Katex from '../components/Katex.astro';
import type { ExamConfig } from '../lib/exam/types';
// KaTeX's stylesheet must come after the site stylesheet, as on the legacy pages: both set
// `.katex { font-size }` and the later one wins (1.21em from KaTeX, not 1.1em from styles.css).
// Astro puts bundled CSS at the end of <head>, after the <link> that <Katex> writes in place,
// so the stylesheet is also imported here, after BaseLayout and its global.css.
import 'katex/dist/katex.min.css';

interface Props {
  title: string;
  description: string;
  config: ExamConfig;
  /** Simulation 3: keep the problem counts in the markup of a page with track selection. */
  staticCounts?: boolean;
}

const { title, description, config, staticCounts = false } = Astro.props;

const paid = config.access.kind === 'paid';
const tracks = config.trackSelection;
/** Simulations 1 to 3 write the counts into the markup; simulation 4 writes zeros. */
const counts = !tracks || staticCounts;

const first = config.tracks[0];
const countOf = (slot: 'info' | 'mate'): number =>
  counts ? (first.sections.find((section) => section.slot === slot)?.problems.length ?? 0) : 0;
const infoN = countOf('info');
const mateN = countOf('mate');
const totalN = infoN + mateN;

/** JSON for an inline script, safe against `</script>` in the values. */
const js = (value: string): string => JSON.stringify(value).replace(/</g, '\\u003c');

const startLines: string[] = [];
if (config.access.kind === 'paid') {
  const { simulationId, label, buyUrl } = config.access;
  startLines.push(`window.simulationId = ${js(simulationId)};`);
  if (label !== undefined) startLines.push(`window.simulationLabel = ${js(label)};`);
  if (buyUrl !== undefined) startLines.push(`window.simulationBuyUrl = ${js(buyUrl)};`);
  if (config.startsAt !== undefined)
    startLines.push(`window.examGateStart = new Date(${js(config.startsAt)});`);
  if (config.startsAtLabel !== undefined) {
    startLines.push(`window.examGateStartLabel = ${js(config.startsAtLabel)};`);
  }
}
const startScript = startLines.join('\n');

const Content = paid ? 'div' : Fragment;
const contentProps = paid ? { id: 'exam-content', style: 'display:none' } : {};

const pageStyles = `
        /* ── Track selector ──────────────────────────────────── */
        .track-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1.5rem;
            max-width: 720px;
            margin: 0 auto 2rem;
        }
        .track-card {
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            gap: 1.25rem;
            padding: 2.5rem 2rem;
            background: var(--glass-bg-light);
            border: 1px solid var(--glass-border);
            border-radius: 20px;
            color: var(--text);
            position: relative;
            overflow: hidden;
            cursor: pointer;
            transition: border-color 0.25s ease, box-shadow 0.25s ease, transform 0.2s ease;
        }
        .track-card::before {
            content: '';
            position: absolute;
            top: 0; left: 10%; right: 10%;
            height: 1px;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.08), transparent);
        }
        .track-card:hover { transform: translateY(-3px); }
        .track-card.track-info { border-color: rgba(77,182,172,0.2); }
        .track-card.track-info:hover { border-color: rgba(77,182,172,0.5); box-shadow: 0 12px 40px rgba(77,182,172,0.12); }
        .track-card.track-fizica { border-color: rgba(251,191,36,0.2); }
        .track-card.track-fizica:hover { border-color: rgba(251,191,36,0.5); box-shadow: 0 12px 40px rgba(251,191,36,0.12); }
        .track-icon {
            width: 64px; height: 64px; border-radius: 18px;
            display: flex; align-items: center; justify-content: center;
            font-size: 1.5rem; font-weight: 700; flex-shrink: 0;
        }
        .track-info .track-icon { background: rgba(77,182,172,0.12); border: 1px solid rgba(77,182,172,0.3); color: var(--accent3); }
        .track-fizica .track-icon { background: rgba(251,191,36,0.12); border: 1px solid rgba(251,191,36,0.3); color: #fbbf24; }
        .track-title { font-size: 1.3rem; font-weight: 700; line-height: 1.3; margin: 0; }
        .track-info .track-title { color: #a8d5d0; }
        .track-fizica .track-title { color: #fde68a; }
        .track-desc { font-size: 0.95rem; color: var(--muted); line-height: 1.6; margin: 0; }
        .track-cta {
            display: inline-flex; align-items: center; gap: 0.5rem;
            padding: 0.75rem 1.75rem; border-radius: 12px;
            font-size: 0.95rem; font-weight: 600; margin-top: auto;
            transition: transform 0.2s;
        }
        .track-info .track-cta { background: rgba(77,182,172,0.15); border: 1px solid rgba(77,182,172,0.35); color: var(--accent3); }
        .track-fizica .track-cta { background: rgba(251,191,36,0.15); border: 1px solid rgba(251,191,36,0.35); color: #fbbf24; }
        .track-card:hover .track-cta { transform: scale(1.04); }
        .sim-badge-date {
            display: inline-flex; align-items: center; gap: 0.4rem;
            background: rgba(255,202,75,0.1); border: 1px solid rgba(255,202,75,0.25);
            color: var(--gold); font-size: 0.88rem; font-weight: 600;
            padding: 0.35rem 0.85rem; border-radius: 20px; margin-bottom: 1rem;
        }
        @media (max-width: 600px) {
            .track-grid { grid-template-columns: 1fr; max-width: 360px; }
            .track-title { font-size: 1.15rem; }
        }

        /* ── Fizica mode: override teal → amber ───────────── */
        #quiz-area.fizica-mode .sim-tab.tab-info { border-color: rgba(251,191,36,0.15); }
        #quiz-area.fizica-mode .sim-tab.tab-info.active { background: rgba(86,86,86,0.05); color: #fde68a; }
        #quiz-area.fizica-mode .sim-tab.active.tab-info::after { background: linear-gradient(90deg, transparent, #fbbf24, transparent); }
        #quiz-area.fizica-mode .sim-tab.tab-info:hover:not(.active) { background: rgba(251,191,36,0.06); }
        #quiz-area.fizica-mode .sim-tab.tab-info .sim-tab-icon { background: rgba(251,191,36,0.1); border-color: rgba(251,191,36,0.25); color: #fbbf24; }
        #quiz-area.fizica-mode .sim-tab.tab-info .sim-tab-badge { background: rgba(251,191,36,0.15); border-color: rgba(251,191,36,0.25); color: #fbbf24; }
        #quiz-area.fizica-mode .sim-progress-fill.fill-info { background: linear-gradient(90deg, rgba(251,191,36,0.9), rgba(251,191,36,0.5)); }
        #quiz-area.fizica-mode .sim-q-number.info-num { background: rgba(251,191,36,0.1); border-color: rgba(251,191,36,0.3); color: #fbbf24; }
        #quiz-area.fizica-mode .sim-q-number.info-num.done { background: rgba(251,191,36,0.3); border-color: rgba(251,191,36,0.5); color: #fff; }
        #quiz-area.fizica-mode .sim-minimap-dot.answered-info { background: rgba(251,191,36,0.5); border-color: rgba(251,191,36,0.8); color: #fff; }
        #quiz-area.fizica-mode .sim-timer-dot.filled-info { background: #fbbf24; box-shadow: 0 0 4px rgba(251,191,36,0.5); }
        #quiz-area.fizica-mode #panel-info .sim-question:hover { border-color: rgba(251,191,36,0.25); }
        #quiz-area.fizica-mode #panel-info .sim-question.answered { border-color: rgba(251,191,36,0.25); }
        #quiz-area.fizica-mode #panel-info .sim-answer { background: rgba(251,191,36,0.04); border-color: rgba(251,191,36,0.1); }
        #quiz-area.fizica-mode #panel-info .sim-answer:hover { background: rgba(251,191,36,0.1); border-color: rgba(251,191,36,0.35); }
        #quiz-area.fizica-mode #panel-info .sim-answer.selected { background: rgba(251,191,36,0.12); border-color: rgba(251,191,36,0.45); box-shadow: 0 0 16px rgba(251,191,36,0.08); }
        #quiz-area.fizica-mode #panel-info .sim-answer.selected .sim-answer-check { border-color: #fbbf24; background: rgba(251,191,36,0.12); }
        #quiz-area.fizica-mode #panel-info .sim-answer.selected .sim-answer-check::after { background: #fbbf24; }
        #quiz-area.fizica-mode #panel-info .sim-answer-check { border-color: rgba(251,191,36,0.25); }

        /* ── Figuri (scheme de circuit) ───────────────────────── */
        .fig-svg {
            display: block;
            width: 100%;
            max-width: 520px;
            height: auto;
            margin: 1.1rem auto 0.3rem;
            color: #cbd5e6;
        }
    `;
---

<BaseLayout title={title} description={description} popup={false}>
  {startScript !== '' && <script is:inline slot="head" set:html={startScript} />}
  <Katex slot="head" />
  {tracks && <style is:inline slot="head" set:html={pageStyles} />}

  {/* Markup copied from the legacy pages; the inline whitespace is part of the extracted text. */}
  <!-- prettier-ignore -->
  <main>
    <div class="grid-main-content">
      {paid && <div id="exam-gate" class="exam-gate-msg" style="display:none"></div>}
      <Content {...contentProps}>
      <section class="container" style="padding-bottom: 1rem; overflow: visible;">
        {tracks && (
        <div id="track-selector" class="sim-start">
          <slot name="track-selector" />
        </div>
        )}

        <div id="quiz-area" class="sim-quiz-area">
          <div class="sim-timer-bar">
            <div class="sim-timer-left">
              Timp ramas:
              <div class="sim-timer-clock" id="timer-clock">03:00:00</div>
            </div>
            <div class="sim-timer-progress">
              <span id="timer-answered">0/{totalN}</span> rezolvate
              <div class="sim-timer-dots" id="timer-dots"></div>
            </div>
          </div>
          <div class="sim-tabs">
            <div class="sim-tab tab-info active" onclick="switchTab('info')">
              {tracks ? (
              <Fragment>
              <span class="sim-tab-icon" id="disc-tab-icon">{'{ }'}</span>
              <span id="disc-tab-label">Informatica</span>
              </Fragment>
              ) : (
              <Fragment>
              <span class="sim-tab-icon">{'{ }'}</span>
              Informatica
              </Fragment>
              )}
              <span class="sim-tab-badge" id="badge-info">0/{infoN}</span>
            </div>
            <div class="sim-tab tab-mate" onclick="switchTab('mate')">
              <span class="sim-tab-icon">&sum;</span>
              Matematica
              <span class="sim-tab-badge" id="badge-mate">0/{mateN}</span>
            </div>
          </div>
          <div class="sim-panel active" id="panel-info">
            <div class="sim-progress-wrap">
              <div class="sim-progress-header">
                <span class="sim-progress-label" id={tracks ? 'disc-progress-label' : undefined}>Progres Informatica</span>
                <span class="sim-progress-count" id="progress-count-info">0 / {infoN} rezolvate</span>
              </div>
              <div class="sim-progress-bar">
                <div class="sim-progress-fill fill-info" id="progress-fill-info" style="width: 0%;"></div>
              </div>
            </div>
            <div class="sim-minimap" id="minimap-info"></div>
            <div id="questions-info"></div>
          </div>
          <div class="sim-panel" id="panel-mate">
            <div class="sim-progress-wrap">
              <div class="sim-progress-header">
                <span class="sim-progress-label">Progres Matematica</span>
                <span class="sim-progress-count" id="progress-count-mate">0 / {mateN} rezolvate</span>
              </div>
              <div class="sim-progress-bar">
                <div class="sim-progress-fill fill-mate" id="progress-fill-mate" style="width: 0%;"></div>
              </div>
            </div>
            <div class="sim-minimap" id="minimap-mate"></div>
            <div id="questions-mate"></div>
          </div>
          <div class="sim-submit-area">
            {counts ? (
            <div class="sim-submit-summary">
              <div class="sim-submit-stat">{tracks ? <span id="disc-submit-label">Informatica:</span> : 'Informatica:'} <b id="submit-count-info">0</b>/{infoN}</div>
              <div class="sim-submit-stat">Matematica: <b id="submit-count-mate">0</b>/{mateN}</div>
              <div class="sim-submit-stat">Total: <b id="submit-count-total">0</b>/{totalN}</div>
            </div>
            ) : (
            <div class="sim-submit-summary">
              <div class="sim-submit-stat"><span id="disc-submit-label">Informatica:</span> <b id="submit-count-info">0</b>/<span id="submit-total-info">0</span></div>
              <div class="sim-submit-stat">Matematica: <b id="submit-count-mate">0</b>/<span id="submit-total-mate">0</span></div>
              <div class="sim-submit-stat">Total: <b id="submit-count-total">0</b>/<span id="submit-total-total">0</span></div>
            </div>
            )}
            <button class="sim-submit-btn" onclick="submitAll()">Finalizeaza Simularea</button>
          </div>
        </div>

        <div id="results-screen" style="display:none;"></div>

      </section>
      </Content>
    </div>
  </main>

  <Fragment slot="scripts">
    {paid && <GateFallback />}
    <slot name="scripts" />
  </Fragment>
</BaseLayout>
